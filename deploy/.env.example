# PVTKRRX self-host stack — environment template
# Copy this file to .env in the same directory and fill in your values:
#   cp deploy/.env.example deploy/.env
#
# Lines starting with '#' are comments and are ignored by Docker Compose.

# ── PVTKRRX ───────────────────────────────────────────────────────────────────

# Public URL that Stremio clients will use to reach this server.
# Required for remote (non-LAN) Stremio installs.  Leave empty for local-only
# use where you will install the addon via http://localhost:7000/configure.
PVTKRRX_PUBLIC_BASE_URL=

# Playback base URL used in stream manifests.  Defaults to PVTKRRX_PUBLIC_BASE_URL
# when not set.  Useful if playback is served from a different origin or CDN.
PVTKRRX_PLAYBACK_BASE_URL=

# Admin password / token for the self-host configuration UI.
# A random value is generated and saved to disk on first start if left empty,
# but setting one here makes it predictable across container restarts.
PVTKRRX_SERVER_ADMIN_TOKEN=

# HTTPS mode.  Options:
#   skip    — no TLS inside the container (default); use a reverse proxy for HTTPS
#   domain  — enable built-in TLS (requires PVTKRRX_PUBLIC_BASE_URL to be set)
PVTKRRX_SELF_HOST_HTTPS_MODE=skip

# Prowlarr and qBittorrent URLs as seen from inside the PVTKRRX container.
# The default values use Docker service DNS names defined in the compose file
# and should not need changing unless you rename the services.
PVTKRRX_DEFAULT_PROWLARR_URL=http://prowlarr:9696
PVTKRRX_DEFAULT_QBIT_URL=http://qbittorrent:8080

# ── Host port mappings ────────────────────────────────────────────────────────
# Change these if the default ports conflict with other services on your host.
PVTKRRX_HOST_PORT=7000
QBITTORRENT_HOST_PORT=8080
PROWLARR_HOST_PORT=9696

# ── LinuxServer image settings (qBittorrent + Prowlarr) ──────────────────────
# Set these to match the UID/GID of the user that should own downloaded files
# on the host.  Run `id` on your host to find the right values.
PUID=1000
PGID=1000
TZ=Etc/UTC

# ── Download path (host-side) ─────────────────────────────────────────────────
# Absolute path on the Docker host where completed downloads are stored.
# This directory is bind-mounted into both the qBittorrent and PVTKRRX
# containers so PVTKRRX can serve completed files for playback.
DOWNLOADS_PATH=./downloads
