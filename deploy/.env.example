# PVTKRRX self-host stack — environment template
# Copy this file to deploy/.env and fill in your values:
#   cp deploy/.env.example deploy/.env
#
# Lines starting with '#' are comments and are ignored by Docker Compose.

# ── Secrets (REQUIRED before first start) ────────────────────────────────────
#
# Generate strong random values, e.g.:
#   openssl rand -base64 32
#
# ENCRYPTION_SECRET is used to encrypt the local-config.json that stores your
# Prowlarr API key, qBittorrent credentials, and other settings.  If you lose
# this value your saved config becomes unreadable.
#
# If you leave these empty, the entrypoint generates random values on first boot
# and persists them on the data volume via /data/pvtkrrx/.env.  Rebuilding the
# container image without a matching data volume will then regenerate new secrets,
# making the old local-config.json unreadable.  Set them explicitly to be safe.
ENCRYPTION_SECRET=
AUTH_TOKEN_SECRET=

# Admin password / token for the self-host /configure UI.
# A random value is generated and saved to the data volume on first start if
# left empty.  The entrypoint will print it to logs.
PVTKRRX_SERVER_ADMIN_TOKEN=

# ── PVTKRRX ───────────────────────────────────────────────────────────────────

# Public HTTPS URL that Stremio clients will use to reach this server.
# Required for remote (non-LAN) Stremio installs.  Leave empty for local-only
# use; install the addon via http://localhost:7000/configure.
PVTKRRX_PUBLIC_BASE_URL=

# Playback base URL (defaults to PVTKRRX_PUBLIC_BASE_URL when not set).
# Useful if stream playback is served from a different origin or CDN.
PVTKRRX_PLAYBACK_BASE_URL=

# HTTPS mode.  Options:
#   skip    — no TLS inside the container (default); use a reverse proxy for HTTPS
#   domain  — enable built-in TLS (requires PVTKRRX_PUBLIC_BASE_URL)
PVTKRRX_SELF_HOST_HTTPS_MODE=skip

# Prowlarr and qBittorrent URLs as seen from inside the PVTKRRX container.
# These use Docker service DNS names and are written into local-config.json by
# server-installer.js --auto on first boot (as fallbacks when no local service
# is detected).  Change only if you rename the services in the compose file.
PVTKRRX_PROWLARR_URL=http://prowlarr:9696
PVTKRRX_QBIT_URL=http://qbittorrent:8080

# ── Host port mappings ────────────────────────────────────────────────────────
# Change these if the defaults conflict with other services on your host.
PVTKRRX_HOST_PORT=7000
QBITTORRENT_HOST_PORT=8080
PROWLARR_HOST_PORT=9696

# ── LinuxServer image settings (qBittorrent + Prowlarr) ──────────────────────
# Set to match the UID/GID of the user that should own downloaded files on the
# host.  Run `id` in your terminal to find the right values.
PUID=1000
PGID=1000
TZ=Etc/UTC

# ── Downloads path (bind-mount variant) ──────────────────────────────────────
# Only needed if you switch from the default Docker-managed `downloads` volume
# to a host bind-mount.  See the commented-out volume block at the bottom of
# docker-compose.selfhost.yml.
DOWNLOADS_PATH=./downloads
